{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvia:schema:catalog-page:v1",
  "title": "Catalog page",
  "description": "Body of GET /v1/catalog (plan 15.3, 16.2). Items are ordered by item_id; next_cursor is opaque, stable across additions, and null on the last page. current_version_id is the prepared immutable snapshot, or null when the item has not been prepared yet (preparation happens when a manifest is requested or the item is queued). Titles are returned only to authenticated devices.",
  "type": "object",
  "required": ["schema_version", "items", "next_cursor"],
  "properties": {
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "kind",
          "title",
          "asset_count",
          "total_bytes",
          "modified_at",
          "current_version_id",
          "preparation_state"
        ],
        "properties": {
          "item_id": { "$ref": "#/$defs/uuid" },
          "kind": { "enum": ["single", "group"] },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" }
          },
          "asset_count": { "type": "integer", "minimum": 1 },
          "total_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "modified_at": { "$ref": "#/$defs/timestamp" },
          "current_version_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "preparation_state": { "enum": ["not_prepared", "ready", "source_unavailable"] }
        }
      }
    },
    "next_cursor": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
