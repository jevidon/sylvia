{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sylvia:schema:device-inbox-page:v1",
  "title": "Device inbox page",
  "description": "Body of GET /v1/device-inbox: the Mac's durable outbound queue entries for the authenticated device (plan 15.1, 15.3, 16.2). Entries are ordered by queue sequence; next_cursor is opaque and null on the last page. Listing an entry moves it from queued_on_mac to observed_by_phone; it never implies an automatic import. item_version_id is the immutable version prepared for the entry; if the original changed, the entry points at the newer version and the old one is no longer served. state shows the separate acknowledgements: queued_on_mac, observed_by_phone, downloaded_to_phone, imported_into_sylvia, or import_failed (entry kept for retry).",
  "type": "object",
  "required": ["schema_version", "entries", "next_cursor"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["queue_entry_id", "item_id", "item_version_id", "title", "total_bytes", "queued_at", "state"],
        "properties": {
          "queue_entry_id": { "$ref": "#/$defs/uuid" },
          "item_id": { "$ref": "#/$defs/uuid" },
          "item_version_id": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "not": { "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]" }
          },
          "total_bytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "queued_at": { "$ref": "#/$defs/timestamp" },
          "state": {
            "enum": ["queued_on_mac", "observed_by_phone", "downloaded_to_phone", "imported_into_sylvia", "import_failed"]
          }
        }
      }
    },
    "next_cursor": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_-]+$" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
