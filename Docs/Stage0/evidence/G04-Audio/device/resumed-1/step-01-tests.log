decoder_seek	long-formats/long-flac-10h.flac	t=3601.3	remuxed_error_ms=0.0 (peak 1.000)	source_error_ms=59.2 (peak 1.000)	max_abs_sample_difference=0.610779 over 173790 samples
decoder_seek	long-formats/long-flac-10h.flac	t=36344.0	remuxed_error_ms=-0.0 (peak 1.000)	source_error_ms=17.7 (peak 1.000)	max_abs_sample_difference=0.657410 over 175620 samples
