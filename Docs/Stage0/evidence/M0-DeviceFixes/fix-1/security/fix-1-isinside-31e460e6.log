     1	import Foundation
     2	import Testing
     3	@testable import SylviaRecovery
     4	
     5	/// Scratch copy only (security review of 26 October 2026, finding S2): the expectations the security fix adds to
     6	/// `PrivatePathTests.containmentFollowsLinks`, with that test's setup, run on another commit's code.
     7	@Suite("Security fix S2, in a scratch copy")
     8	struct SecurityS2ScratchTests {
     9	    @Test("isInside never counts a path with . or .. below a missing folder as inside")
    10	    func isInsideAlone() throws {
    11	        let scratch = try Scratch()
    12	        let fm = FileManager.default
    13	        let root = scratch.dir("Bundle")
    14	        try fm.createDirectory(at: root.appending(path: "export/markdown", directoryHint: .isDirectory), withIntermediateDirectories: true)
    15	        try Data("x".utf8).write(to: root.appending(path: "export/markdown/a.md"))
    16	        let outside = scratch.dir("Outside")
    17	        try fm.createDirectory(at: outside, withIntermediateDirectories: true)
    18	        try Data("y".utf8).write(to: outside.appending(path: "b.md"))
    19	        for form in PrivatePathTests.forms(root) {
    20	            let base = form.url
    21	            print("isInside, \(form.label): " + ["missing/../../Outside/b.md", "missing/..", "export/../export/markdown/a.md", "export/../../Outside/b.md"]
    22	                .map { "\($0) -> \(BackupValidator.isInside(base.appending(path: $0), base))" }.joined(separator: "; "))
    23	            // So `isInside` itself, not only `resolve` (which refuses such components first), never counts such a path
    24	            // as inside (security review of 26 October 2026, finding S2). Once `missing` exists, the first path names
    25	            // the file outside and the second the root itself. A `..` in the part that exists is resolved, as the file
    26	            // system resolves it.
    27	            for path in ["missing/../../Outside/b.md", "missing/.."] {
    28	                #expect(!BackupValidator.isInside(base.appending(path: path), base), "\(form.label): \(path)")
    29	            }
    30	            #expect(BackupValidator.isInside(base.appending(path: "export/../export/markdown/a.md"), base), "\(form.label)")
    31	            #expect(!BackupValidator.isInside(base.appending(path: "export/../../Outside/b.md"), base), "\(form.label)")
    32	        }
    33	    }
    34	}
