<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The keychain access group the companion app would use for its identity key (data protection keychain).
  Nothing else: no sandbox exception, no network server entitlement (the probe does not listen).
-->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.jevidon.sylvia.spike.identityprobe</string>
	</array>
</dict>
</plist>
