<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ATS PROBE VARIANT ONLY (G0.2 part 2): the G02TransferATSVariant app built with G02_ATS_VARIANT=tailnet-exception.
  Measures whether a per-domain exception for Tailscale names (ts.net) and the Tailscale address range
  (100.64.0.0/10, CIDR form, iOS 17+) lets the SPKI-pinned client reach the Mac there. The only ATS key that
  loosens server trust, NSExceptionAllowsInsecureHTTPLoads, also allows cleartext HTTP to those hosts; that cost
  is part of what is being measured. Never the harness's or the product's configuration; Scripts/ci.d/40-g02-transfer.sh
  allows ATS keys only in Config/ATSVariant-*.plist.
-->
<plist version="1.0">
<dict>
	<key>G02ATSVariant</key>
	<string>tailnet-exception</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_sylvia-src._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sylvia connects to the Mac you paired with on your network to download books and audiobooks you send to this iPhone.</string>
</dict>
</plist>
